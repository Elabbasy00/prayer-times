# App Configuration
APP_NAME=MobileStarter
APP_ENV=development

# API Configuration
API_URL_DEV=http://10.0.2.2:8000/api
API_URL_STAGING=https://staging-api.yourdomain.com/api
API_URL_PRODUCTION=https://api.yourdomain.com/api
API_TIMEOUT=15000

# Feature Flags
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTING=false
ENABLE_DEBUG_MENU=true

# Third-Party Services (Add your keys here)
# GOOGLE_MAPS_API_KEY=
# FIREBASE_API_KEY=
# SENTRY_DSN=
# MIXPANEL_TOKEN=

# Social Authentication
# GOOGLE_CLIENT_ID=
# FACEBOOK_APP_ID=
# APPLE_CLIENT_ID=

# App Store Configuration
# IOS_APP_ID=
# ANDROID_PACKAGE_NAME=

# Deep Linking
DEEP_LINK_SCHEME=yourapp
DEEP_LINK_HOST=yourapp.com

# Build Configuration
CODE_PUSH_DEPLOYMENT_KEY_IOS=
CODE_PUSH_DEPLOYMENT_KEY_ANDROID=
